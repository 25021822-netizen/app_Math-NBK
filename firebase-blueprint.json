{
  "entities": {
    "User": {
      "title": "User",
      "description": "User profile in Math&NBK platform",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "email": { "type": "string" },
        "role": { "type": "string", "enum": ["student", "teacher", "admin"] },
        "tier": { "type": "string", "enum": ["free", "premium"] },
        "xp": { "type": "number" },
        "streakDays": { "type": "number" },
        "lastActiveDate": { "type": "string" },
        "dailyScanCount": { "type": "number" },
        "maxDailyScans": { "type": "number" },
        "grade": { "type": "number" },
        "avatar": { "type": "string" },
        "schoolName": { "type": "string" },
        "phone": { "type": "string" },
        "bio": { "type": "string" },
        "password": { "type": "string" },
        "status": { "type": "string", "enum": ["active", "pending_approval", "rejected"] },
        "requestedAt": { "type": "string" },
        "rejectionReason": { "type": "string" },
        "subject": { "type": "string" }
      },
      "required": ["id", "name", "email", "role"]
    },
    "Classroom": {
      "title": "Classroom",
      "description": "Classroom in Math&NBK platform",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "code": { "type": "string" },
        "grade": { "type": "number" },
        "teacherId": { "type": "string" },
        "teacherName": { "type": "string" },
        "visibility": { "type": "string", "enum": ["public", "private"] }
      },
      "required": ["id", "name", "code", "teacherId"]
    },
    "Submission": {
      "title": "Submission",
      "description": "Student exam submission",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "examId": { "type": "string" },
        "studentId": { "type": "string" },
        "score": { "type": "number" }
      },
      "required": ["id", "examId", "studentId"]
    },
    "CheatLog": {
      "title": "CheatLog",
      "description": "Anti-cheat infraction log",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "examId": { "type": "string" },
        "studentId": { "type": "string" },
        "reason": { "type": "string" }
      },
      "required": ["id", "examId", "studentId"]
    },
    "ClassroomLesson": {
      "title": "ClassroomLesson",
      "description": "Lesson and assignment posted by teacher to classroom",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "classId": { "type": "string" },
        "chapter": { "type": "string" },
        "title": { "type": "string" },
        "description": { "type": "string" },
        "teacherName": { "type": "string" },
        "createdAt": { "type": "string" }
      },
      "required": ["id", "classId", "title"]
    },
    "ClassroomMessage": {
      "title": "ClassroomMessage",
      "description": "Chat message sent in classroom group",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "classId": { "type": "string" },
        "senderId": { "type": "string" },
        "senderName": { "type": "string" },
        "content": { "type": "string" },
        "timestamp": { "type": "string" }
      },
      "required": ["id", "classId", "senderId", "content"]
    },
    "Exam": {
      "title": "Exam",
      "description": "Exam created in Math&NBK platform",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "title": { "type": "string" },
        "topic": { "type": "string" },
        "grade": { "type": "number" },
        "durationMinutes": { "type": "number" },
        "totalPoints": { "type": "number" },
        "createdBy": { "type": "string" },
        "distributionType": { "type": "string", "enum": ["classes", "repository"] },
        "createdAt": { "type": "string" }
      },
      "required": ["id", "title"]
    },
    "PublishedExam": {
      "title": "PublishedExam",
      "description": "Published exam stored in dedicated Firebase collection",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "examId": { "type": "string" },
        "title": { "type": "string" },
        "topic": { "type": "string" },
        "grade": { "type": "number" },
        "durationMinutes": { "type": "number" },
        "totalPoints": { "type": "number" },
        "questionsCount": { "type": "number" },
        "createdBy": { "type": "string" },
        "distributionType": { "type": "string", "enum": ["classes", "repository"] },
        "status": { "type": "string", "enum": ["published"] },
        "publishedAt": { "type": "string" },
        "updatedAt": { "type": "string" }
      },
      "required": ["id", "examId", "title", "status", "publishedAt"]
    },
    "ExamImage": {
      "title": "ExamImage",
      "description": "Cloud-synced cropped exam question or option image",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "examId": { "type": "string" },
        "dataUrl": { "type": "string" },
        "updatedAt": { "type": "string" }
      },
      "required": ["id", "dataUrl"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": { "$ref": "#/entities/User" },
      "description": "User profiles and authentication status"
    },
    "/classrooms/{classId}": {
      "schema": { "$ref": "#/entities/Classroom" },
      "description": "Classrooms"
    },
    "/submissions/{submissionId}": {
      "schema": { "$ref": "#/entities/Submission" },
      "description": "Student exam submissions"
    },
    "/cheatLogs/{logId}": {
      "schema": { "$ref": "#/entities/CheatLog" },
      "description": "Anti-cheat logs"
    },
    "/lessons/{lessonId}": {
      "schema": { "$ref": "#/entities/ClassroomLesson" },
      "description": "Classroom lessons and study chapters"
    },
    "/exams/{examId}": {
      "schema": { "$ref": "#/entities/Exam" },
      "description": "Exams created by teachers"
    },
    "/published_exams/{examId}": {
      "schema": { "$ref": "#/entities/PublishedExam" },
      "description": "Dedicated collection storing all published exams"
    },
    "/exam_images/{imageId}": {
      "schema": { "$ref": "#/entities/ExamImage" },
      "description": "Cropped exam question and answer images synced across devices"
    },
    "/messages/{msgId}": {
      "schema": { "$ref": "#/entities/ClassroomMessage" },
      "description": "Classroom chat messages"
    }
  }
}
