rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{userId} {
      allow read, write: if true;
    }
    match /classrooms/{classId} {
      allow read, write: if true;
    }
    match /submissions/{subId} {
      allow read, write: if true;
    }
    match /cheatLogs/{logId} {
      allow read, write: if true;
    }
    match /lessons/{lessonId} {
      allow read, write: if true;
    }
    match /exams/{examId} {
      allow read, write: if true;
    }
    match /published_exams/{examId} {
      allow read, write: if true;
    }
    match /messages/{msgId} {
      allow read, write: if true;
    }
    match /meta/{metaId} {
      allow read, write: if true;
    }
    match /exam_images/{imageId} {
      allow read, write: if true;
    }
    match /admin_broadcasts/{broadcastId} {
      allow read, write: if true;
    }
    match /test/{docId} {
      allow read: if true;
    }
  }
}
